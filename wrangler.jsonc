{
  // Cloudflare deploy config — static site served from ./public
  // (an assets-only Worker; no server code). Only files under ./public are
  // published, so research/ and other repo files stay private.
  "name": "getleadflowsites",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./public",
    // While the site is "coming soon", serve index.html for any unmatched
    // path so every URL on the domain shows the placeholder (not a 404).
    "not_found_handling": "single-page-application"
  }
}
